    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.2",
    "pdfjs-dist": "^6.3.289",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
